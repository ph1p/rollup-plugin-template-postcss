{
  "name": "rollup-plugin-template-postcss",
  "version": "1.1.3",
  "description": "Rollup starter plugin",
  "keywords": [
    "css",
    "lit",
    "postcss",
    "rollup",
    "rollup-plugin",
    "template"
  ],
  "homepage": "https://github.com/ph1p/rollup-plugin-template-postcss",
  "bugs": {
    "url": "https://github.com/ph1p/rollup-plugin-template-postcss/issues"
  },
  "license": "MIT",
  "author": "Philip Stapelfeldt",
  "repository": "ph1p/rollup-plugin-template-postcss",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "release": "semantic-release",
    "pretest": "pnpm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "oxlint .",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-virtual": "^3.0.2",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "rollup": "^4.60.2",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4.2.4",
    "tsdown": "^0.21.10",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "postcss": "^8.4.40"
  },
  "packageManager": "pnpm@10.33.2"
}
